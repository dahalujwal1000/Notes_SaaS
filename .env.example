# Copy to `.env` (gitignored) or add to your hosting dashboard.
# Real environment variables always override these.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Email verification ---
# "console"  → verification links go to server logs (default, no credentials)
# "smtp"     → real delivery via Gmail SMTP / Brevo relay (or any SMTP host)
# "resend"   → Resend API (needs RESEND_API_KEY + a verified domain)
MAIL_BACKEND=smtp
MAIL_USER=<your SMTP login: Gmail address, or Brevo SMTP login from Settings → SMTP & API>
MAIL_APP_PASSWORD=<16-char Gmail App Password, or Brevo SMTP key (xsmtpsib-…)
# Optional SMTP overrides:
#   MAIL_HOST = SMTP hostname (default smtp.gmail.com, or smtp-relay.brevo.com
#               when MAIL_APP_PASSWORD is a Brevo key; MAIL_SERVER is accepted
#               as an alias but MAIL_HOST is the documented name)
#   MAIL_PORT = 587 (STARTTLS, default) or 465 (implicit SSL)
#   MAIL_FROM = From address (default = MAIL_USER; must be a Brevo-verified
#               sender if you use Brevo — avoid gmail.com From addresses there)
# Brevo SMTP relay:  MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
# If MAIL_BACKEND=smtp but MAIL_APP_PASSWORD is blank, the app logs a warning
# and captures the verification link to the server logs instead of sending.
# Test credentials anytime with:  venv\Scripts\python mailtest.py --send you@example.com
# Mail verification is enforced at login by default. Set EMAIL_VERIFICATION_REQUIRED=false
# to let unverified accounts log in (local/sandbox testing only).
EMAIL_VERIFICATION_REQUIRED=true

# --- Sign in with Google (free) ---
# Create credentials (free, no billing): Google Cloud Console →
# APIs & Services → Credentials → Create credentials → OAuth client ID →
# "Web application". Add both "Authorized redirect URIs":
#   http://127.0.0.1:8000/auth/google/callback
#   https://<your-app>.onrender.com/auth/google/callback
# Then paste the client ID + secret here (Google users are auto-verified —
# no verification email needed for them).
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-secret
# --- AI assistant (free LLM, no credit card) ---
# Provider: gemini (recommended, key from aistudio.google.com) | groq (console.groq.com)
# | mock (offline demo assistant, no key needed). With no AI_PROVIDER and no key
# the app falls back to the mock provider. AI_ENABLED=false turns /ai routes off (403).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_ENABLED=true
AI_RATE_LIMIT_PER_HOUR=30
